# Environment variables (NEVER commit credentials!)
.env

# Local client config (copy from client.config.example.json)
client.config.json
.secrets/
secrets/
*.secret.json
*.service-account.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.so
.Python
venv/
env/
ENV/
.venv/
.venv

# Node / TypeScript
node_modules/

# Logs
logs/
*.log

# IDE / local agent worktrees (not repo source)
.claude/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary files
temp/
tmp/
*.tmp

# Local work artifacts (batch outputs, agent tracking, exports)
work/
!work/
work/*
!work/seo/
work/seo/*
# Screaming Frog: track README only (crawl dumps stay local)
!work/seo/screaming_frog/
work/seo/screaming_frog/**
!work/seo/screaming_frog/README.md

# Hub / Google review archives and sync dumps (operator-local)
workspace/comment_archive/
**/_google_sync/

# DataForSEO evidence: keep summaries/configs; ignore bulky raw inputs
workspace/content_pipeline/research/**/inputs/
workspace/content_pipeline/research/**/working/
workspace/content_pipeline/research/**/raw/
workspace/content_pipeline/research/**/*.log
workspace/content_pipeline/research/**/*dataforseo_raw*.json
workspace/content_pipeline/research/**/seeds/

# HogEye workspace at repo root — ignore bulky media, keep README
workspace/content_pipeline/sources/media_inbox/*
!workspace/content_pipeline/sources/media_inbox/README.md
workspace/content_pipeline/sources/transcripts/raw/*.mp3
workspace/content_pipeline/sources/transcripts/raw/*.wav
workspace/content_pipeline/sources/transcripts/raw/*.m4a
# `archive/` at repo root is versioned (superseded docs/scripts); use `backups/` for local-only snapshots
backups/
temp_images_for_analysis/
image_batch_*_for_analysis.json
image_metadata_generated*.json
image_metadata_generated*.csv

# Test outputs
test_output/

# Raw content (before conversion)
raw_content/pages/*
raw_content/posts/*
raw_content/images/*
!raw_content/pages/.gitkeep
!raw_content/posts/.gitkeep
!raw_content/images/.gitkeep
!raw_content/README.md
