# Wildlife Dominion brand portal — strategy + content ingest
# Copy to .env (gitignored) and fill in real values, or set as CI/repo secrets.
# Used by `npm run push:strategy`, `npm run push:content`, and `npm run pull:approved`.
DASHBOARD_URL=https://wildlife-dominion-dashboard.jason-17f.workers.dev
WD_INGEST_KEY=replace-with-real-ingest-key-do-not-commit
# Fail-closed editorial style/taste gate used before Hub ingest.
TYPESAFE_API_KEY=

# Optional: brand slug for pull:approved (defaults to hogeye-cameras in this repo).
# One of: boar-blanket | big-pig-traps | hogeye-cameras
WD_BRAND=hogeye-cameras

# Optional: default authorEmail attached to pushed content (override with --author-email).
WD_AUTHOR_EMAIL=
