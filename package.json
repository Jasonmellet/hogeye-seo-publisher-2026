{
  "name": "hogeye-seo-content-publisher-2026",
  "version": "1.0.0",
  "description": "HogEye SEO publisher plus Theo-style content ingestion runtime.",
  "scripts": {
    "openai:ping": "tsx scripts/content-system/ping_openai.ts",
    "transcribe": "tsx scripts/content-system/transcribe_video.ts",
    "process-transcript": "tsx scripts/content-system/process_transcript.ts",
    "ingest-source": "tsx scripts/content-system/ingest_source_text.ts",
    "validate-artifact": "tsx scripts/content-system/validate_artifact.ts",
    "librarian:audit": "tsx scripts/content-system/librarian_audit.ts",
    "librarian:apply": "tsx scripts/content-system/librarian_apply.ts",
    "google:doc": "tsx scripts/content-system/fetch_google_doc.ts",
    "google:doc-comments": "tsx scripts/content-system/fetch_google_doc.ts --comments-only",
    "google:doc-comments-open": "tsx scripts/content-system/fetch_google_doc.ts --comments-only --open-only",
    "google:archive-comments": "tsx scripts/content-system/archive_google_doc_comments.ts",
    "google:archive-comments-open": "tsx scripts/content-system/archive_google_doc_comments.ts --open-only",
    "google:archive-suggestions": "tsx scripts/content-system/archive_google_doc_suggestions.ts",
    "google:archive-doc-review": "tsx scripts/content-system/archive_google_doc_comments.ts --open-only && tsx scripts/content-system/archive_google_doc_suggestions.ts && tsx scripts/content-system/render_google_doc_review_bundle.ts",
    "google:render-review-bundle": "tsx scripts/content-system/render_google_doc_review_bundle.ts",
    "google:render-review-bundle-full": "tsx scripts/content-system/render_google_doc_review_bundle.ts --full",
    "google:export-tab-plain": "tsx scripts/content-system/export_google_strategy_tab_plain.ts",
    "google:push-tabs": "tsx scripts/content-system/push_google_strategy_tabs.ts",
    "agent:batch-review": "tsx scripts/content-system/agent_batch_review.ts",
    "google:redline-full": "tsx scripts/content-system/generate_google_redline.ts",
    "push:strategy": "node scripts/push-seo-strategy.mjs",
    "push:content": "node scripts/push-content.mjs",
    "pull:approved": "node scripts/pull-approved.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jasonmellet/hogeye-seo-publisher-2026.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Jasonmellet/hogeye-seo-publisher-2026/issues"
  },
  "homepage": "https://github.com/Jasonmellet/hogeye-seo-publisher-2026#readme",
  "dependencies": {
    "dotenv": "^17.4.1",
    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
